---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

const { title, description } = Astro.props;
---
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Hashti Design System` : 'Hashti Design System'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/hashti-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,400&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <ClientRouter />
    <script is:inline>
      (function() {
        function syncHashtiTheme() {
          const isDark = document.documentElement.classList.contains('dark');
          document.documentElement.setAttribute('data-hashti-theme', isDark ? 'g100' : 'white');
        }
        syncHashtiTheme();
        const observer = new MutationObserver(syncHashtiTheme);
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        document.addEventListener('astro:after-swap', syncHashtiTheme);
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
