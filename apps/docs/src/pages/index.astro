---
import Layout from '@/layouts/Layout.astro';
import { HeroShowcase } from '@/components/HeroShowcase';
import { CopyCommand } from '@/components/CopyCommand';
---

<Layout
  title="Hashti — The Architectural Portal Design System for Modern React"
  description="Inspired by the transitional geometry of Iranian vestibules (Hashti). Uncompromising accessibility, zero-runtime tokens, and compound composition ergonomics."
>
  <!-- Main Home Container -->
  <div class="relative overflow-hidden bg-[#fafafa] dark:bg-[#0a0a0a] text-neutral-900 dark:text-neutral-100 min-h-screen selection:bg-[#08BDBA]/30">
    <!-- Ambient architectural radial gradients -->
    <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-gradient-to-b from-[#08BDBA]/10 via-[#D97706]/5 to-transparent blur-3xl opacity-70"></div>
    <div class="pointer-events-none absolute top-40 -left-40 w-96 h-96 bg-[#08BDBA]/10 rounded-full blur-3xl"></div>
    <div class="pointer-events-none absolute top-60 -right-40 w-96 h-96 bg-[#D97706]/10 rounded-full blur-3xl"></div>

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/70 dark:bg-black/60 border-b border-neutral-200/80 dark:border-neutral-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/hashti-mark.svg" alt="Hashti logo" class="w-8 h-8 transition-transform group-hover:scale-105" />
          <span class="font-bold text-lg tracking-tight font-sans">
            هشتی <span class="text-neutral-400 dark:text-neutral-500 font-normal">|</span> Hashti
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-600 dark:text-neutral-300">
          <a href="/docs" class="hover:text-black dark:hover:text-white transition-colors">Documentation</a>
          <a href="/docs/components/button" class="hover:text-black dark:hover:text-white transition-colors">Components</a>
          <a href="/docs/foundations/brandbook" class="hover:text-black dark:hover:text-white transition-colors">Brandbook</a>
          <a href="/docs/getting-started/theming" class="hover:text-black dark:hover:text-white transition-colors">Themes</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="https://github.com/raminrez/hashti"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg text-neutral-600 dark:text-neutral-300 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
            aria-label="GitHub Repository"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <a
            href="/docs"
            class="px-4 py-2 rounded-lg text-sm font-medium bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shadow-sm"
          >
            Documentation
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="relative pt-16 pb-12 sm:pt-24 sm:pb-16 lg:pt-28 lg:pb-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/80 text-xs sm:text-sm font-medium text-neutral-800 dark:text-neutral-200 shadow-sm mb-8 backdrop-blur-sm">
          <span class="font-bold text-[#08BDBA]">هشتی Hashti v1.0</span>
          <span class="text-neutral-400">•</span>
          <span>React Aria Components 1.22.1 + HeroUI v3 Architecture</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-neutral-950 dark:text-white leading-[1.1] mb-6">
          The Architectural Portal Design System for Modern React Applications.
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-lg sm:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed mb-10">
          Inspired by the transitional geometry of Iranian vestibules (<em>Hashti</em>). Uncompromising accessibility, zero-runtime tokens, and compound composition ergonomics.
        </p>

        <!-- CTA & Command -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
          <a
            href="/docs/components/button"
            class="w-full sm:w-auto px-7 py-3 rounded-xl font-medium text-sm bg-neutral-950 text-white dark:bg-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-md hover:shadow-lg"
          >
            Explore Components
          </a>
          <a
            href="https://github.com/raminrez/hashti"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3 rounded-xl font-medium text-sm border border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-600 bg-white/80 dark:bg-neutral-900/80 text-neutral-800 dark:text-neutral-200 transition-colors shadow-sm"
          >
            GitHub
          </a>
          <CopyCommand client:load command="bun add @hashti/react @hashti/tokens" />
        </div>

        <!-- Interactive Component Stage (Hero Showcase) -->
        <div class="mt-8">
          <HeroShowcase client:load />
        </div>
      </div>
    </section>

    <!-- Architectural Philosophy Section (The Hashti Transition) -->
    <section class="py-20 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-100/40 dark:bg-neutral-950/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-xs uppercase tracking-widest font-mono text-[#08BDBA] font-semibold mb-2">
            Spatial Philosophy • معماری هشتی
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
            The Hashti Spatial Transition
          </h2>
          <p class="mt-4 text-neutral-600 dark:text-neutral-400 leading-relaxed text-base sm:text-lg">
            In Iranian vernacular architecture, the journey between the chaotic public street and the tranquil domestic sanctuary is an unbroken sequence of deliberate spatial pauses.
          </p>
        </div>

        <!-- 4 Architectural Stages Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- 1. Darvazeh -->
          <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-sm shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-[#08BDBA]/10 text-[#08BDBA] flex items-center justify-center font-bold font-mono mb-4 text-sm">
              01
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">
              دروازه • Darvazeh
            </h3>
            <div class="text-xs font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider font-mono mb-3">
              The Portal Threshold
            </div>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              The monumental pointed ogival entrance arch signaling intentional boundary crossing. Commands respect and introduces identity before raw data interacts with the system.
            </p>
          </div>

          <!-- 2. Hashti -->
          <div class="p-6 rounded-2xl border border-[#08BDBA]/40 dark:border-[#08BDBA]/40 bg-gradient-to-b from-[#08BDBA]/5 to-transparent dark:from-[#08BDBA]/10 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-[#08BDBA] text-white flex items-center justify-center font-bold font-mono mb-4 text-sm shadow-sm">
              02
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">
              هشتی • Hashti
            </h3>
            <div class="text-xs font-semibold text-[#08BDBA] uppercase tracking-wider font-mono mb-3">
              Octagonal Transitional Vestibule
            </div>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              The octagonal chamber of sensory equilibrium. Diffused zenithal skylight and cool masonry benches allow reception, focus trapping, and state normalization without visual exposure.
            </p>
          </div>

          <!-- 3. Dalan -->
          <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-sm shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-[#D97706]/10 text-[#D97706] flex items-center justify-center font-bold font-mono mb-4 text-sm">
              03
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">
              دالان • Dalan
            </h3>
            <div class="text-xs font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider font-mono mb-3">
              The Indirect Corridors
            </div>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              A 90-degree bent hallway mathematically guarding against direct lines of sight. Maps directly to nested elevations, overlay drawers, and progressive state disclosure.
            </p>
          </div>

          <!-- 4. Hayati -->
          <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-sm shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono mb-4 text-sm">
              04
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">
              حیاطی • Hayati
            </h3>
            <div class="text-xs font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider font-mono mb-3">
              Inner Courtyard Sanctuary
            </div>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              The finished application interface: anchored by luminous turquoise reflecting pools, natural proportions, balanced typography, and delight for the human user.
            </p>
          </div>
        </div>

        <!-- Visual Geometry & Palette Banner -->
        <div class="mt-12 p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm flex flex-col lg:flex-row items-center justify-between gap-8">
          <div class="space-y-2 max-w-xl text-center lg:text-left">
            <h4 class="text-xl font-bold text-neutral-950 dark:text-white">
              Mathematical Vaulted Arches & Mineral Glazes
            </h4>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Pure <code class="px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 font-mono text-xs text-neutral-900 dark:text-neutral-100">#000000</code> and <code class="px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 font-mono text-xs text-neutral-900 dark:text-neutral-100">#FFFFFF</code> monochrome structure accented by authentic Persian Turquoise (<code class="text-[#08BDBA] font-mono text-xs">#08BDBA</code>), Isfahan Amber (<code class="text-[#D97706] font-mono text-xs">#D97706</code>), and Terracotta Clay (<code class="text-[#DC2626] font-mono text-xs">#DC2626</code>).
            </p>
          </div>

          <!-- Color Swatch Strip -->
          <div class="flex items-center gap-3">
            <div class="flex flex-col items-center gap-1.5">
              <span class="w-12 h-12 rounded-xl bg-black border border-neutral-700 shadow-inner"></span>
              <span class="text-[11px] font-mono text-neutral-500">Basalt</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <span class="w-12 h-12 rounded-xl bg-white border border-neutral-200 shadow-sm"></span>
              <span class="text-[11px] font-mono text-neutral-500">Chalk</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <span class="w-12 h-12 rounded-xl bg-[#08BDBA] shadow-sm"></span>
              <span class="text-[11px] font-mono text-neutral-500">Turquoise</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <span class="w-12 h-12 rounded-xl bg-[#D97706] shadow-sm"></span>
              <span class="text-[11px] font-mono text-neutral-500">Amber</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <span class="w-12 h-12 rounded-xl bg-[#DC2626] shadow-sm"></span>
              <span class="text-[11px] font-mono text-neutral-500">Terracotta</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="text-xs uppercase tracking-widest font-mono text-[#08BDBA] font-semibold mb-2">
          Engineering Foundations
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
          Built for Scale, Accessibility, and Velocity
        </h2>
        <p class="mt-4 text-neutral-600 dark:text-neutral-400 text-base sm:text-lg">
          Uncompromising production requirements engineered directly into the component tree.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Feature 1 -->
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-lg mb-4">
            ♿
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white mb-2">
            React Aria Components 1.22.1
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            WAI-ARIA compliant, full keyboard roving tabindex, typeahead letter jumping, and screen reader certified across desktop and mobile browsers.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-lg mb-4">
            🧩
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white mb-2">
            Compound Ergonomics
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <code class="text-xs font-mono">&lt;Select.Trigger&gt;</code>, <code class="text-xs font-mono">&lt;Select.Value&gt;</code>, <code class="text-xs font-mono">&lt;Select.Popover&gt;</code> — flexible composition over rigid prop drilling.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-lg mb-4">
            🎨
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white mb-2">
            8 Themes (WCAG AA Certified)
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Light and dark palettes strictly verified for ≥ 4.5:1 contrast ratios on essential controls and 7:1 for body copy.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-lg mb-4">
            ⚡
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white mb-2">
            Modular Scoped Styling
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Scoped CSS per component with zero runtime overhead. Pre-compiled CSS variables integrate cleanly with Tailwind CSS v4.
          </p>
        </div>
      </div>
    </section>

    <!-- Getting Started Code Block -->
    <section class="py-20 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-100/30 dark:bg-neutral-950/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
            Get Started in 3 Steps
          </h2>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Install packages, import styles, and render accessible compound components.
          </p>
        </div>

        <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-950 text-neutral-100 overflow-hidden shadow-2xl">
          <!-- Code Block Header -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-neutral-800 bg-neutral-900/60 font-mono text-xs text-neutral-400">
            <span class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
              <span>Quickstart Setup Guide</span>
            </span>
            <span>bash + tsx</span>
          </div>

          <!-- Code Steps -->
          <div class="p-6 space-y-6 font-mono text-sm leading-relaxed overflow-x-auto">
            <div>
              <div class="text-xs uppercase text-neutral-500 font-semibold mb-2 tracking-wider">
                1. Install packages
              </div>
              <div class="text-[#08BDBA]">$ bun add @hashti/react @hashti/tokens react-aria-components</div>
            </div>

            <div class="pt-4 border-t border-neutral-800/80">
              <div class="text-xs uppercase text-neutral-500 font-semibold mb-2 tracking-wider">
                2. Import stylesheets in root layout
              </div>
              <div class="text-neutral-400">// app/layout.tsx or src/main.tsx</div>
              <div class="text-neutral-300">import <span class="text-[#08BDBA]">"@hashti/tokens/tokens.css"</span>;</div>
              <div class="text-neutral-300">import <span class="text-[#08BDBA]">"@hashti/react/styles.css"</span>;</div>
            </div>

            <div class="pt-4 border-t border-neutral-800/80">
              <div class="text-xs uppercase text-neutral-500 font-semibold mb-2 tracking-wider">
                3. Render component inside Theme
              </div>
              <div class="text-neutral-300">import &#123; <span class="text-[#D97706]">Theme</span>, <span class="text-[#D97706]">Button</span> &#125; from <span class="text-[#08BDBA]">"@hashti/react"</span>;</div>
              <div class="text-neutral-400 pt-2">// Wrap any application subtree</div>
              <div class="text-neutral-300">&lt;<span class="text-[#D97706]">Theme</span> theme=<span class="text-[#08BDBA]">"frame-light"</span>&gt;</div>
              <div class="text-neutral-300 ps-4">&lt;<span class="text-[#D97706]">Button</span> variant=<span class="text-[#08BDBA]">"primary"</span> onPress=&#123;() =&gt; console.log(<span class="text-[#08BDBA]">"Portal open"</span>)&#125;&gt;</div>
              <div class="text-neutral-300 ps-8">Enter Portal</div>
              <div class="text-neutral-300 ps-4">&lt;/<span class="text-[#D97706]">Button</span>&gt;</div>
              <div class="text-neutral-300">&lt;/<span class="text-[#D97706]">Theme</span>&gt;</div>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <a
            href="/docs/getting-started/installation"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#08BDBA] hover:underline"
          >
            Read the comprehensive installation guide &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-neutral-200 dark:border-neutral-800 py-12 bg-white dark:bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
        <div class="flex items-center gap-2">
          <img src="/hashti-mark.svg" alt="Hashti mark" class="w-5 h-5" />
          <span>Hashti Design System • Apache 2.0 Licensed</span>
        </div>
        <div>
          Architectural Portal Design System for Modern React Applications
        </div>
      </div>
    </footer>
  </div>
</Layout>
