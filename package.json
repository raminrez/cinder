{
  "name": "hashti-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-aria-components": "1.22.1",
      "@internationalized/date": "3.12.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  },
  "scripts": {
    "dev": "bun run build:tokens && bun run --cwd apps/docs dev",
    "build": "bun scripts/build.ts",
    "build:packages": "bun scripts/build.ts --packages",
    "build:docs": "bun --cwd apps/docs build",
    "docs": "bun --cwd apps/docs dev",
    "build:tokens": "bun packages/tokens/scripts/generate.ts",
    "storybook": "bun run --cwd apps/storybook dev",
    "build:storybook": "bun run --cwd apps/storybook build",
    "pack": "bun run build && bun scripts/pack.ts",
    "start": "bun scripts/preview.ts",
    "typecheck": "bun check --no-script -p tsconfig.json && bun run typecheck:storybook",
    "typecheck:storybook": "bun run --cwd apps/storybook typecheck",
    "lint": "bun run --bun oxlint",
    "lint:fix": "bun run lint --fix",
    "test": "bun test tests/unit packages/react/src packages/agent/src ./apps/storybook/.storybook/watch-packages.test.ts",
    "test:browser": "bun test --timeout 60000 tests/browser",
    "test:package": "bun scripts/verify-package.ts",
    "cleanup": "rimraf node_modules apps/*/node_modules packages/*/node_modules dist apps/*/dist packages/*/dist apps/docs/.astro apps/*/storybook-static playwright-report test-results apps/storybook/debug-storybook.log",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run build:storybook && bun run test:browser && bun scripts/pack.ts && bun run test:package"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@internationalized/date": "catalog:",
    "@types/bun": "1.4.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun": "1.4.4",
    "oxlint": "1.91.0",
    "playwright": "1.65.0",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "^6.1.4",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "bun"
  ],
  "msw": {
    "workerDirectory": [
      "apps/storybook/public"
    ]
  }
}
